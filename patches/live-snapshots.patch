+++ b/forge-gui-desktop/src/main/java/forge/view/MatchlabSnapshots.java
@@ -0,0 +1,166 @@
+package forge.view;
+
+import com.google.common.eventbus.Subscribe;
+import com.google.common.collect.Multiset;
+import forge.game.Game;
+import forge.game.GameLogEntry;
+import forge.game.card.Card;
+import forge.game.card.CounterType;
+import forge.game.event.GameEvent;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbilityStackInstance;
+import forge.game.zone.ZoneType;
+import java.util.*;
+
+/** Opt-in, synchronous spectator snapshots from real engine state; never changes RNG or game state. */
+public final class MatchlabSnapshots {
+    private final Game game;
+    private final int gameNumber;
+    private final long started = System.nanoTime();
+    private int sequence;
+    private int logged;
+    private boolean failed;
+    private String previousState;
+    private final Map<Integer,Map<String,String>> previousZones = new HashMap<>();
+
+    public MatchlabSnapshots(Game game, int gameNumber) {
+        this.game = game;
+        this.gameNumber = gameNumber;
+    }
+
+    @Subscribe public void onEvent(GameEvent event) {
+        String kind = event.getClass().getSimpleName();
+        // Priority and mana-pool chatter adds volume without meaningful board transitions.
+        if (kind.equals("GameEventPlayerPriority") || kind.equals("GameEventManaPool")
+                || kind.equals("GameEventCombatUpdate")) return;
+        emit(kind);
+    }
+
+    public void emit(String kind) {
+        if (failed) return;
+        try {
+            Map<String,Object> snapshot = map("version",1,"game",gameNumber,"sequence",sequence+1,
+                "event",kind,"captured_seconds",(System.nanoTime()-started)/1e9,
+                "turn",game.getPhaseHandler().getTurn(),
+                "phase",String.valueOf(game.getPhaseHandler().getPhase()),
+                "active_player",game.getPhaseHandler().getPlayerTurn() == null ? null
+                    : game.getPhaseHandler().getPlayerTurn().getId());
+            List<Object> players = new ArrayList<>();
+            for (Player p : game.getPlayers()) {
+                Map<String,Object> zones = new LinkedHashMap<>();
+                for (ZoneType z : new ZoneType[]{ZoneType.Battlefield,ZoneType.Hand,ZoneType.Graveyard,ZoneType.Exile,ZoneType.Command}) {
+                    List<Object> cards = new ArrayList<>();
+                    for (Card c : p.getCardsIn(z)) cards.add(card(c));
+                    zones.put(z.name(),cards);
+                }
+                zones.put("Library",map("count",p.getCardsIn(ZoneType.Library).size()));
+                players.add(map("id",p.getId(),"name",p.getName(),"life",p.getLife(),
+                    "poison",p.getPoisonCounters(),"max_land_plays",p.getMaxLandPlays(),
+                    "max_land_plays_infinite",p.getMaxLandPlaysInfinite(),
+                    "lands_played_this_turn",p.getLandsPlayedThisTurn(),"zones",zones));
+            }
+            snapshot.put("players",players);
+            List<Object> stack = new ArrayList<>();
+            for (SpellAbilityStackInstance item : game.getStack())
+                stack.add(map("text",item.getStackDescription()));
+            snapshot.put("stack",stack);
+            List<GameLogEntry> entries = game.getGameLog().getLogEntries(null);
+            List<Object> actions = new ArrayList<>();
+            int fresh = Math.max(0,entries.size()-logged);
+            for (int i=fresh-1;i>=0;i--) {
+                GameLogEntry entry = entries.get(i);
+                actions.add(map("kind",entry.type().name(),"text",entry.toString()));
+            }
+            logged = entries.size();
+            snapshot.put("actions",actions);
+            String state = json(map("turn",snapshot.get("turn"),"phase",snapshot.get("phase"),
+                "active_player",snapshot.get("active_player"),"players",players,"stack",stack));
+            // Zone/stat events often repeat without changing real state. Keep every state transition
+            // and every actual log delta, while avoiding repeated copies of an unchanged board.
+            if (state.equals(previousState) && actions.isEmpty()
+                    && !kind.equals("Initial") && !kind.equals("Final")) return;
+            previousState = state;
+            sequence++;
+            boolean full = kind.equals("Initial") || kind.equals("Final");
+            snapshot.put("delta",!full);
+            compactZones(players,full);
+            System.out.println("MATCHLAB_SNAPSHOT " + json(snapshot));
+            System.out.flush();
+        } catch (RuntimeException error) {
+            // Spectator failure must not change a game result, but must be visible.
+            failed = true;
+            System.err.println("MATCHLAB_SNAPSHOT_ERROR " + error.getClass().getName() + ": " + error.getMessage());
+        }
+    }
+
+    private Object card(Card c) {
+        Map<String,Object> counters = new LinkedHashMap<>();
+        for (Multiset.Entry<CounterType> entry : c.getCounters().entrySet())
+            counters.put(entry.getElement().getName(),entry.getCount());
+        return map("id",c.getId(),"name",c.getName(),"tapped",c.isTapped(),"token",c.isToken(),
+            "power",c.isCreature()?c.getNetPower():null,
+            "toughness",c.isCreature()?c.getNetToughness():null,"counters",counters,
+            "land",c.isLand(),"creature",c.isCreature(),"planeswalker",c.isPlaneswalker(),"artifact",c.isArtifact(),
+            "attacking",game.getCombat()!=null && game.getCombat().getAttackers().contains(c),
+            "blocking",game.getCombat()!=null && !game.getCombat().getAttackersBlockedBy(c).isEmpty(),
+            "owner",c.getOwner()==null?null:c.getOwner().getId(),
+            "controller",c.getController()==null?null:c.getController().getId());
+    }
+
+    @SuppressWarnings("unchecked")
+    private void compactZones(List<Object> players, boolean full) {
+        // Explicit lossless zone deltas: omitted zones mean exactly the previously emitted zone.
+        // Initial/Final frames are complete; consumers materialize intermediate frames by player id.
+        for (Object raw : players) {
+            Map<String,Object> player = (Map<String,Object>)raw;
+            Integer id = (Integer)player.get("id");
+            Map<String,Object> zones = (Map<String,Object>)player.get("zones");
+            Map<String,String> prior = previousZones.computeIfAbsent(id,k -> new HashMap<>());
+            Iterator<Map.Entry<String,Object>> iterator = zones.entrySet().iterator();
+            while(iterator.hasNext()) {
+                Map.Entry<String,Object> entry = iterator.next();
+                String state = json(entry.getValue());
+                String old = prior.put(entry.getKey(),state);
+                if (!full && state.equals(old)) iterator.remove();
+            }
+        }
+    }
+
+    static Map<String,Object> map(Object... pairs) {
+        Map<String,Object> result = new LinkedHashMap<>();
+        for(int i=0;i<pairs.length;i+=2) result.put((String)pairs[i],pairs[i+1]);
+        return result;
+    }
+
+    // Avoid adding a JSON dependency to the pinned upstream desktop build.
+    static String json(Object value) {
+        if(value==null) return "null";
+        if(value instanceof Boolean || value instanceof Number) return value.toString();
+        if(value instanceof Map) {
+            List<String> parts = new ArrayList<>();
+            for(Object raw : ((Map<?,?>)value).entrySet()) {
+                Map.Entry<?,?> entry = (Map.Entry<?,?>)raw;
+                parts.add(json(entry.getKey().toString())+":"+json(entry.getValue()));
+            }
+            return "{"+String.join(",",parts)+"}";
+        }
+        if(value instanceof Iterable) {
+            List<String> parts = new ArrayList<>();
+            for(Object item : (Iterable<?>)value) parts.add(json(item));
+            return "["+String.join(",",parts)+"]";
+        }
+        StringBuilder escaped = new StringBuilder("\"");
+        for(char c : value.toString().toCharArray()) {
+            switch(c) {
+                case '"': escaped.append("\\\""); break;
+                case '\\': escaped.append("\\\\"); break;
+                case '\n': escaped.append("\\n"); break;
+                case '\r': escaped.append("\\r"); break;
+                case '\t': escaped.append("\\t"); break;
+                default: if(c<32) escaped.append(String.format("\\u%04x",(int)c)); else escaped.append(c);
+            }
+        }
+        return escaped.append('"').toString();
+    }
+}
+
